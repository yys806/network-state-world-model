+def _venue(item: dict[str, Any]) -> tuple[str, str]:
+    """Use Zotero's item-type schema rather than treating every paper as a journal."""
+    fields = {
+        "conferencePaper": ("proceedingsTitle", "conferenceName"),
+        "preprint": ("repository", "archive"),
+        "report": ("institution", "seriesTitle"),
+        "thesis": ("university",),
+        "book": ("publisher",),
+        "bookSection": ("bookTitle", "publisher"),
+    }.get(item.get("itemType", ""), ("publicationTitle",))
+    for field in fields:
+        if item.get(field):
+            return str(item[field]), field
+    return "", "/".join(fields)
