# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.worktrees/

# Runtime and local scratch files
.tmp/
tmp/
*.pid
*.log

# LaTeX intermediate files
*.aux
*.out
*.synctex*
*.toc
*.fls
*.fdb_latexmk

# Office temporary files
~$*.docx
~$*.pptx
~$*.xlsx

# Generated research outputs stay local; only governance metadata is versioned.
代码/artifacts/*
!代码/artifacts/README.md
!代码/artifacts/manifests/
!代码/artifacts/manifests/**

# AirFogSim is an independent third-party checkout.
代码/reference/AirFogSim/

# Large local research attachments and generated presentation outputs.
文档/文献/
文档/组会/
文档/研究进展/papers/
文档/研究进展/ton_template_extract/
文档/研究进展/*.pdf
文档/研究进展/*.zip
文档/研究进展/IEEEtran.cls
